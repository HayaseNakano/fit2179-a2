{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Household Income by State Over Time",
    "subtitle": "Selected states · 1970–2022 · hh_income_state.csv",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://HayaseNakano.github.io/fit2179-a2/data/hh_income_state.csv"
  },
  "transform": [
    {
      "filter": "indexof(['W.P. Kuala Lumpur','Selangor','Johor','Sabah','Kelantan','Perak'], datum.state) >= 0"
    },
    {"filter": "datum.income_median != null"}
  ],
  "mark": {"type": "line", "point": false, "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year",
      "axis": {"format": "%Y", "labelFontSize": 10, "titleFontSize": 12, "grid": false}
    },
    "y": {
      "field": "income_median",
      "type": "quantitative",
      "title": "Median Monthly Income (RM)",
      "axis": {"format": ",.0f", "labelFontSize": 10, "titleFontSize": 12, "gridColor": "#e0e0d8", "gridDash": [3,3]}
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": ["W.P. Kuala Lumpur","Selangor","Johor","Perak","Sabah","Kelantan"],
        "range": ["#0c447c","#1a5fa8","#5599cc","#aaaaaa","#888888","#cc3333"]
      },
      "legend": {"title": "State", "labelFontSize": 10, "titleFontSize": 11}
    },
    "strokeWidth": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": ["W.P. Kuala Lumpur","Selangor","Johor","Perak","Sabah","Kelantan"],
        "range": [2.5, 2, 1.5, 1.5, 1.5, 2]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "date", "type": "temporal", "title": "Year", "format": "%Y"},
      {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"}
    ]
  },
  "config": {"view": {"stroke": null}, "background": "#ffffff"}
}
