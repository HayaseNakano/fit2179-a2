{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia's Human Development Index (1990–2023)",
    "subtitle": "HDI combines income, education and life expectancy into one score · UNDP HDR · hdi_clean.csv",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 260,
  "data": {
    "url": "https://HayaseNakano.github.io/fit2179-a2/data/hdi_clean.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {"color": "#1a5fa8", "strokeWidth": 2.5},
        "color": "#ddeeff",
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "scale": {"domain": [1990, 2023]},
          "axis": {"format": "d", "labelFontSize": 10, "titleFontSize": 12, "grid": false, "tickCount": 8}
        },
        "y": {
          "field": "hdi",
          "type": "quantitative",
          "title": "HDI Value",
          "scale": {"domain": [0.62, 0.82]},
          "axis": {"labelFontSize": 10, "titleFontSize": 12, "gridColor": "#e0e0d8", "gridDash": [3,3], "format": ".2f"}
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "hdi", "type": "quantitative", "title": "HDI Value", "format": ".3f"}
        ]
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 30, "color": "#1a5fa8", "opacity": 0.6},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "hdi", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.year == 1990 || datum.year == 2023"}],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#0c447c", "dy": -10},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "hdi", "type": "quantitative"},
        "text": {"field": "hdi", "type": "quantitative", "format": ".3f"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "background": "#ffffff"}
}
