{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Monthly Household Income by State (2022)",
    "subtitle": "W.P. Kuala Lumpur, W.P. Putrajaya and Selangor lead the nation",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666",
    "anchor": "start"
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },
      "transform": [
        {
          "calculate": "indexof(['W.P. Kuala Lumpur', 'W.P. Putrajaya', 'Selangor'], datum.state) >= 0 ? 'Top 3' : 'Others'",
          "as": "highlight"
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "sort": "-x",
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13
          }
        },
        "x": {
          "field": "income_median",
          "type": "quantitative",
          "title": "Median Monthly Household Income (RM)",
          "axis": {
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 13
          }
        },
        "color": {
          "field": "highlight",
          "type": "nominal",
          "scale": {
            "domain": [
              "Top 3",
              "Others"
            ],
            "range": [
              "#1a6eb5",
              "#cccccc"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "income_mean",
            "type": "quantitative",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "type": "quantitative",
            "title": "Poverty Rate (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 6338
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#333333",
        "fontWeight": "bold",
        "y": 8
      },
      "encoding": {
        "x": {
          "datum": 6338
        },
        "text": {
          "value": "National median RM 6,338"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#555555",
        "y": 22
      },
      "encoding": {
        "x": {
          "datum": 6338
        },
        "text": {
          "value": "10 of 16 states fall below"
        }
      }
    }
  ]
}