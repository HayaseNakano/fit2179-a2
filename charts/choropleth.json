{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Monthly Household Income by State (2022)",
    "subtitle": "Darker colour = higher median income \u00b7 Hover over a state for details",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator",
    "center": [
      110.0,
      4.0
    ],
    "scale": 2400
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#a8d4f0",
        "stroke": null
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            2,
            2
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#88b8d8",
        "strokeWidth": 0.3,
        "strokeOpacity": 0.6
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/neighbours.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4d4d4",
        "stroke": "#b0b0b0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/malaysia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
            },
            "key": "state",
            "fields": [
              "income_median",
              "income_mean",
              "poverty",
              "gini"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "income_median",
          "type": "quantitative",
          "scale": {
            "range": [
              "#c7e9c0",
              "#74c476",
              "#238b45"
            ],
            "domain": [
              3000,
              11000
            ]
          },
          "legend": {
            "title": "Median Income (RM)",
            "orient": "bottom-right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "gradientLength": 180,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "income_mean",
            "type": "quantitative",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "type": "quantitative",
            "title": "Poverty Rate (%)"
          },
          {
            "field": "gini",
            "type": "quantitative",
            "title": "Gini Coefficient",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Perlis",
            "longitude": 100.48,
            "latitude": 6.65
          },
          {
            "label": "Kedah",
            "longitude": 100.55,
            "latitude": 5.95
          },
          {
            "label": "P. Pinang",
            "longitude": 100.1,
            "latitude": 5.22
          },
          {
            "label": "Perak",
            "longitude": 100.55,
            "latitude": 4.75
          },
          {
            "label": "Putrajaya",
            "longitude": 101.9,
            "latitude": 3.08
          },
          {
            "label": "N. Sembilan",
            "longitude": 102.65,
            "latitude": 2.68
          },
          {
            "label": "Melaka",
            "longitude": 102.55,
            "latitude": 2.28
          },
          {
            "label": "Johor",
            "longitude": 103.45,
            "latitude": 1.95
          },
          {
            "label": "Pahang",
            "longitude": 102.85,
            "latitude": 3.85
          },
          {
            "label": "Terengganu",
            "longitude": 103.35,
            "latitude": 5.15
          },
          {
            "label": "Kelantan",
            "longitude": 101.75,
            "latitude": 5.85
          },
          {
            "label": "Sabah",
            "longitude": 117.0,
            "latitude": 5.9
          },
          {
            "label": "Sarawak",
            "longitude": 113.0,
            "latitude": 2.6
          },
          {
            "label": "Labuan",
            "longitude": 115.35,
            "latitude": 5.05
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "Arial",
        "align": "center",
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Selangor",
            "longitude": 101.3,
            "latitude": 3.55
          },
          {
            "label": "KL",
            "longitude": 101.42,
            "latitude": 3.18
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "Arial",
        "align": "center",
        "color": "#1a1a1a"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff"
  }
}