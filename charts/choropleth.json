{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Monthly Household Income by State (2022)",
    "subtitle": "Darker blue = higher median income · Hover over a state for details",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [110.5, 3.8],
    "scale": 2200
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {
        "type": "geoshape",
        "fill": "#b8d4e8",
        "stroke": null
      }
    },
    {
      "data": {"graticule": {"step": [2, 2]}},
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8ab4cc",
        "strokeWidth": 0.3,
        "strokeOpacity": 0.5
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/neighbours.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e0d0",
        "stroke": "#ccbfa0",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Country"}
        ]
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/malaysia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
            },
            "key": "state",
            "fields": ["income_median", "income_mean", "poverty", "gini"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "income_median",
          "type": "quantitative",
          "scale": {"scheme": "blues", "domain": [3000, 11000]},
          "legend": {
            "title": "Median Income (RM)",
            "orient": "bottom-right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "gradientLength": 180,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {"field": "properties.state", "type": "nominal", "title": "State"},
          {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"},
          {"field": "income_mean", "type": "quantitative", "title": "Mean Income (RM)", "format": ",.0f"},
          {"field": "poverty", "type": "quantitative", "title": "Poverty Rate (%)"},
          {"field": "gini", "type": "quantitative", "title": "Gini Coefficient", "format": ".3f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"label": "Perlis",       "longitude": 100.42, "latitude": 6.60},
          {"label": "Kedah",        "longitude": 100.80, "latitude": 6.18},
          {"label": "P. Pinang",    "longitude": 100.60, "latitude": 5.22},
          {"label": "Perak",        "longitude": 100.70, "latitude": 4.70},
          {"label": "Selangor",     "longitude": 101.85, "latitude": 3.60},
          {"label": "KL",           "longitude": 101.56, "latitude": 3.22},
          {"label": "Putrajaya",    "longitude": 102.10, "latitude": 2.98},
          {"label": "N. Sembilan",  "longitude": 102.40, "latitude": 2.82},
          {"label": "Melaka",       "longitude": 102.40, "latitude": 2.28},
          {"label": "Johor",        "longitude": 103.60, "latitude": 1.95},
          {"label": "Pahang",       "longitude": 102.80, "latitude": 3.80},
          {"label": "Terengganu",   "longitude": 103.50, "latitude": 5.10},
          {"label": "Kelantan",     "longitude": 101.80, "latitude": 5.90},
          {"label": "Sabah",        "longitude": 117.20, "latitude": 5.90},
          {"label": "Sarawak",      "longitude": 113.50, "latitude": 2.55},
          {"label": "Labuan",       "longitude": 115.35, "latitude": 5.10}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "Arial",
        "color": "#1a1a1a",
        "stroke": "#ffffff",
        "strokeWidth": 2.5,
        "strokeOpacity": 0.9
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude":  {"field": "latitude",  "type": "quantitative"},
        "text":      {"field": "label",      "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff"
  }
}
