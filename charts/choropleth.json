{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Monthly Household Income by State (2022)",
    "subtitle": "Darker green = higher median income · Hover over a state for details",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator",
    "center": [110.0, 4.0],
    "scale": 2400
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#a8d4f0", "stroke": null}
    },
    {
      "data": {"graticule": {"step": [2, 2]}},
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#88b8d8",
        "strokeWidth": 0.3,
        "strokeOpacity": 0.6
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/neighbours.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4d4d4",
        "stroke": "#b0b0b0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "Country"}
        ]
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/malaysia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
            },
            "key": "state",
            "fields": ["income_median", "income_mean", "poverty", "gini"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "income_median",
          "type": "quantitative",
          "scale": {"scheme": "greens", "domain": [3000, 11000]},
          "legend": {
            "title": "Median Income (RM)",
            "orient": "bottom-right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "gradientLength": 180,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {"field": "properties.state", "type": "nominal", "title": "State"},
          {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"},
          {"field": "income_mean", "type": "quantitative", "title": "Mean Income (RM)", "format": ",.0f"},
          {"field": "poverty", "type": "quantitative", "title": "Poverty Rate (%)"},
          {"field": "gini", "type": "quantitative", "title": "Gini Coefficient", "format": ".3f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"label": "Perlis",      "longitude": 100.48, "latitude": 6.65, "anchor": "start"},
          {"label": "Kedah",       "longitude": 100.55, "latitude": 5.95, "anchor": "middle"},
          {"label": "P. Pinang",   "longitude": 100.10, "latitude": 5.22, "anchor": "end"},
          {"label": "Perak",       "longitude": 100.55, "latitude": 4.75, "anchor": "middle"},
          {"label": "Selangor",    "longitude": 101.30, "latitude": 3.55, "anchor": "middle"},
          {"label": "KL",          "longitude": 101.42, "latitude": 3.18, "anchor": "middle"},
          {"label": "Putrajaya",   "longitude": 102.20, "latitude": 2.96, "anchor": "start"},
          {"label": "N. Sembilan", "longitude": 102.45, "latitude": 2.75, "anchor": "start"},
          {"label": "Melaka",      "longitude": 102.55, "latitude": 2.28, "anchor": "start"},
          {"label": "Johor",       "longitude": 103.45, "latitude": 1.95, "anchor": "middle"},
          {"label": "Pahang",      "longitude": 102.85, "latitude": 3.85, "anchor": "middle"},
          {"label": "Terengganu", "longitude": 103.35, "latitude": 5.15, "anchor": "start"},
          {"label": "Kelantan",    "longitude": 101.75, "latitude": 5.85, "anchor": "middle"},
          {"label": "Sabah",       "longitude": 117.00, "latitude": 5.90, "anchor": "middle"},
          {"label": "Sarawak",     "longitude": 113.00, "latitude": 2.60, "anchor": "middle"},
          {"label": "Labuan",      "longitude": 115.35, "latitude": 5.05, "anchor": "middle"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "Arial",
        "color": "#1a1a1a",
        "stroke": null,
        "dy": 0
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude":  {"field": "latitude",  "type": "quantitative"},
        "text":      {"field": "label",      "type": "nominal"},
        "align":     {"field": "anchor",     "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff"
  }
}
