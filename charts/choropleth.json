{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Median Monthly Household Income by State (2022)",
    "subtitle": "Darker blue = higher median income · Hover over a state for details",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator",
    "center": [111.0, 4.2],
    "scale": 2800
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {
        "type": "geoshape",
        "fill": "#d6eaf8",
        "stroke": null
      }
    },
    {
      "data": {"graticule": {"step": [2, 2]}},
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#aacce8",
        "strokeWidth": 0.4,
        "strokeOpacity": 0.6
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/malaysia_states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
            },
            "key": "state",
            "fields": ["income_median", "income_mean", "poverty", "gini"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.0
      },
      "encoding": {
        "color": {
          "field": "income_median",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [3000, 11000]
          },
          "legend": {
            "title": "Median Income (RM)",
            "orient": "bottom-right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "gradientLength": 180,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {"field": "properties.state", "type": "nominal", "title": "State"},
          {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"},
          {"field": "income_mean", "type": "quantitative", "title": "Mean Income (RM)", "format": ",.0f"},
          {"field": "poverty", "type": "quantitative", "title": "Poverty Rate (%)"},
          {"field": "gini", "type": "quantitative", "title": "Gini Coefficient", "format": ".3f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"label": "Perlis",      "longitude": 100.20, "latitude": 6.45},
          {"label": "Kedah",       "longitude": 100.65, "latitude": 6.05},
          {"label": "P. Pinang",   "longitude": 100.45, "latitude": 5.30},
          {"label": "Perak",       "longitude": 100.95, "latitude": 4.55},
          {"label": "Selangor",    "longitude": 101.45, "latitude": 3.40},
          {"label": "KL",          "longitude": 101.69, "latitude": 3.16},
          {"label": "Putrajaya",   "longitude": 101.95, "latitude": 2.93},
          {"label": "N. Sembilan", "longitude": 102.15, "latitude": 2.88},
          {"label": "Melaka",      "longitude": 102.28, "latitude": 2.22},
          {"label": "Johor",       "longitude": 103.50, "latitude": 1.85},
          {"label": "Pahang",      "longitude": 102.75, "latitude": 3.72},
          {"label": "Terengganu", "longitude": 103.15, "latitude": 4.85},
          {"label": "Kelantan",    "longitude": 101.95, "latitude": 5.68},
          {"label": "Sabah",       "longitude": 117.20, "latitude": 5.90},
          {"label": "Sarawak",     "longitude": 113.20, "latitude": 2.55},
          {"label": "Labuan",      "longitude": 115.23, "latitude": 5.28}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "font": "Arial",
        "color": "#1a1a1a",
        "stroke": "#ffffff",
        "strokeWidth": 3,
        "strokeOpacity": 1.0
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude":  {"field": "latitude",  "type": "quantitative"},
        "text":      {"field": "label",      "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff"
  }
}
