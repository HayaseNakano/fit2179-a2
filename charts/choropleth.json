{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State-Level Welfare Indicators (2022)",
    "subtitle": "Use dropdown to switch metric \u00b7 Hover over a state for details",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "projection": {
    "type": "mercator",
    "center": [
      110.0,
      4.0
    ],
    "scale": 2400
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#a8d4f0",
        "stroke": null
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            2,
            2
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#88b8d8",
        "strokeWidth": 0.3,
        "strokeOpacity": 0.6
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/neighbours.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4d4d4",
        "stroke": "#b0b0b0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://HayaseNakano.github.io/fit2179-a2/data/malaysia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
            },
            "key": "state",
            "fields": [
              "income_median",
              "income_mean",
              "poverty",
              "gini",
              "expenditure_mean"
            ]
          }
        },
        {
          "calculate": "datum.expenditure_mean / datum.income_median * 100",
          "as": "expenditure_ratio"
        },
        {
          "calculate": "datum[metric]",
          "as": "selected_metric"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "selected_metric",
          "type": "quantitative",
          "scale": {
            "scheme": "orangered",
            "domain": {
              "expr": "metric == 'gini' ? [0.28, 0.52] : metric == 'expenditure_ratio' ? [60, 100] : [0, 22]"
            }
          },
          "legend": {
            "title": {
              "expr": "metric == 'poverty' ? 'Poverty Rate (%)' : metric == 'gini' ? 'Gini Coefficient' : 'Expenditure Ratio (%)'"
            },
            "orient": "bottom-right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "gradientLength": 180,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "poverty",
            "type": "quantitative",
            "title": "Poverty Rate (%)",
            "format": ".1f"
          },
          {
            "field": "gini",
            "type": "quantitative",
            "title": "Gini Coefficient",
            "format": ".3f"
          },
          {
            "field": "expenditure_ratio",
            "type": "quantitative",
            "title": "Expenditure Ratio (%)",
            "format": ".1f"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff"
  },
  "params": [
    {
      "name": "metric",
      "value": "poverty",
      "bind": {
        "input": "select",
        "options": [
          "poverty",
          "gini",
          "expenditure_ratio"
        ],
        "labels": [
          "Poverty Rate (%)",
          "Gini Coefficient",
          "Expenditure Ratio (%)"
        ],
        "name": "Metric: "
      }
    }
  ]
}