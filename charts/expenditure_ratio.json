{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How much is left after households pay their bills?",
    "subtitle": "Higher % = less money left over each month \u00b7 hies_state.csv",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "https://HayaseNakano.github.io/fit2179-a2/data/hies_state.csv"
  },
  "transform": [
    {
      "calculate": "datum.expenditure_mean / datum.income_median * 100",
      "as": "expenditure_ratio"
    },
    {
      "calculate": "datum.expenditure_mean / datum.income_median * 100 >= 85 ? 'High burden' : 'Lower burden'",
      "as": "burden"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#cc3333",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 85
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": -6,
        "fontSize": 10,
        "color": "#cc3333",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "datum": 85
        },
        "y": {
          "datum": "Pahang"
        },
        "text": {
          "value": "85% threshold \u2014 savings become negligible"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },
      "params": [
        {
          "name": "hover_expenditure",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "expenditure_ratio",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 11,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "expenditure_ratio",
          "type": "quantitative",
          "title": "Expenditure as % of Median Income",
          "scale": {
            "domain": [
              0,
              105
            ]
          },
          "axis": {
            "format": ".0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "gridColor": "#e0e0d8",
            "gridDash": [
              3,
              3
            ],
            "domain": false,
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          }
        },
        "color": {
          "field": "burden",
          "type": "nominal",
          "scale": {
            "domain": [
              "High burden",
              "Lower burden"
            ],
            "range": [
              "#cc3333",
              "#1a5fa8"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-left",
            "labelFontSize": 11,
            "symbolSize": 100
          }
        },
        "opacity": {
          "condition": {
            "param": "hover_expenditure",
            "value": 1
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "expenditure_ratio",
            "type": "quantitative",
            "title": "Expenditure Ratio (%)",
            "format": ".1f"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "expenditure_mean",
            "type": "quantitative",
            "title": "Mean Expenditure (RM)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff"
  }
}