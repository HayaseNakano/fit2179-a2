      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#555555"
      },
      "encoding": {
        "x": {"datum": 0},
        "y": {"datum": "Kelantan", "type": "nominal"},
        "text": {"value": "National median RM 6,338"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff",
    "bar": {"binSpacing": 2}
