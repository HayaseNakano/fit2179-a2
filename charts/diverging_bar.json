{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State Income Relative to National Median (2022)",
    "subtitle": "Each bar shows how far a state's median income is above or below the national median of RM 6,338",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#aaaaaa",
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/hies_state.csv"
  },
  "transform": [
    {
      "calculate": "datum.median_income - 6338", 
      "as": "diff"
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2},
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "axis": null, 
          "sort": {"field": "diff", "order": "descending"}
        },
        "x": {
          "field": "diff",
          "type": "quantitative",
          "title": "Difference from National Median (RM)",
          "axis": {
            "grid": true,
            "gridColor": "#e0e0d8",
            "domain": false
          }
        },
        "color": {
          "condition": {
            "test": "datum.diff > 0",
            "value": "#1a5fa8"
          },
          "value": "#c44536"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "median_income", "type": "quantitative", "title": "Median Income (RM)"},
          {"field": "diff", "type": "quantitative", "title": "Gap from Average (RM)"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.diff > 0"}],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -5,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {"datum": 0}, 
        "y": {
          "field": "state",
          "type": "nominal",
          "axis": null, 
          "sort": {"field": "diff", "order": "descending"}
        },
        "text": {"field": "state", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "datum.diff <= 0"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {"datum": 0}, 
        "y": {
          "field": "state",
          "type": "nominal",
          "axis": null, 
          "sort": {"field": "diff", "order": "descending"}
        },
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff",
    "bar": {"binSpacing": 2}
  }
}