            "orient": "top-left",
            "labelFontSize": 11,
            "symbolSize": 80
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"},
          {"field": "diff", "type": "quantitative", "title": "vs National Median (RM)", "format": "+,.0f"}
