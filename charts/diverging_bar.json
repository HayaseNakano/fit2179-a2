  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "diff",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "domain": false,
            "ticks": false,
            "grid": false,
            "labelLimit": 160
          }
        },
        "x": {
          "field": "diff",
          "type": "quantitative",
          "title": "Difference from National Median (RM)",
          "axis": {
            "format": "+,.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "gridColor": "#e0e0d8",
            "gridDash": [
              3,
              3
            ],
            "domain": false,
            "tickCount": 7
          }
        },
        "color": {
          "field": "side",
          "type": "nominal",
          "scale": {
            "domain": [
              "Above national median",
              "Below national median"
            ],
            "range": [
              "#1a5fa8",
              "#cc3333"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-right",
            "labelFontSize": 11,
            "symbolSize": 100,
            "direction": "horizontal",
            "offset": 10
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "diff",
            "type": "quantitative",
            "title": "vs National Median (RM)",
            "format": "+,.0f"
          },
          {
            "field": "side",
            "type": "nominal",
            "title": "Status"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          2
        ]
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "Selangor",
            "diff": 2300,
            "label": "10 of 16 states (62%) fall below"
          },
          {
            "state": "W.P. Putrajaya",
            "diff": 2300,
            "label": "the national median \u2014 the top 3"
          },
          {
            "state": "W.P. Kuala Lumpur",
            "diff": 2300,
            "label": "territories pull the figure up"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#555555"
      },
      "encoding": {
        "x": {
          "field": "diff",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "diff",
            "order": "ascending"
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff"
  }
